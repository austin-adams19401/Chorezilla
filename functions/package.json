{
  "name": "chorezilla-functions",
  "description": "Firebase Cloud Functions for Chorezilla",
  "scripts": {
    "lint": "eslint .",
    "test": "node --test test/logic.test.js",
    "test:rules": "cd .. && firebase emulators:exec --only firestore --project demo-chorezilla \"node --test functions/test/firestore.rules.test.js\"",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "eslint": "^8.15.0",
    "eslint-config-google": "^0.14.0",
    "firebase-functions-test": "^3.1.0",
    "firebase-tools": "^14.11.0"
  },
  "private": true
}
