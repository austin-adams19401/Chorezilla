# Copy to functions/.env before deploying. Do not commit functions/.env.
# RevenueCat → Project → API keys → Secret API key (server only, never the public SDK key).
REVENUECAT_SECRET_API_KEY=

# RevenueCat → Integrations → Webhooks → Authorization header value.
# The function expects this exact secret, with or without a "Bearer " prefix.
REVENUECAT_WEBHOOK_AUTH=
